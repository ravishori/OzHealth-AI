# VitaPulse AI — environment template (NO SECRETS)
# Copy to backend/.env and fill values locally. Never commit real secrets.
#
# Host-run backend (no Docker): use localhost for Postgres/Redis.
# Docker Compose overrides DATABASE_URL / SYNC_DATABASE_URL / REDIS_URL /
# SECRET_KEY for in-container service DNS (postgres, redis) — see docker-compose.yml.

# --- Host-local (Option B / non-Compose) ---
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/VitaPulse%20AI
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@localhost:5432/VitaPulse AI
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_CREDENTIALS_PATH=
DEVELOPER_EMAILS=
# JSON array of allowed browser origins (never use "*")
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]
EPRESCRIPTION_MOCK_MODE=true
ERX_API_KEY=
DEBUG=true
