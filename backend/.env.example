# VitaPulse AI — environment template (NO SECRETS)
# Copy to backend/.env and fill values locally. Never commit real secrets.

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DB
SYNC_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DB
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
REDIS_URL=redis://localhost:6379/0
FIREBASE_CREDENTIALS_PATH=
DEVELOPER_EMAILS=
# JSON array of allowed browser origins (never use "*")
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]
EPRESCRIPTION_MOCK_MODE=true
ERX_API_KEY=
DEBUG=false
