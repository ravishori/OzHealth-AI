# HealthNest / VitaPulse — LOCAL Compose secrets template (NO production values)
# Copy to `.env` in the repository root for `docker compose` variable substitution.
# Never commit the real `.env` file.

# Required for local PostgreSQL container + backend DATABASE_URL injection
POSTGRES_PASSWORD=local_dev_only_change_me

# Required JWT signing secret for local API (generate a long random string)
SECRET_KEY=local-dev-only-replace-with-long-random-string

# Optional local defaults
DEBUG=true
